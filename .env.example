# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=word_journey

# Prisma / API 连接串（与上面四项保持一致）
DATABASE_URL="mysql://root:123456@localhost:3306/word_journey"

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# API
API_PORT=3000
# CORS 允许的前端来源（逗号分隔）
WEB_ORIGIN=http://localhost:5173